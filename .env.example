# Copy to .env and adjust for your environment.
AWS_REGION=us-east-1
INPUT_PATH=s3a://your-bucket/cdn-logs/raw/
OUTPUT_PATH=s3a://your-bucket/cdn-logs/aggregated/
OBSERVABILITY_PATH=s3a://your-bucket/cdn-logs/observability/
DIMENSION_PATH=s3a://your-bucket/cdn-logs/dimensions/edge_regions/

# Local development (overrides S3 when set)
# INPUT_PATH=file:///absolute/path/to/data/sample/
# OUTPUT_PATH=file:///absolute/path/to/data/output/aggregated/
# OBSERVABILITY_PATH=file:///absolute/path/to/data/output/observability/
